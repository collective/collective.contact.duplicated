<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      xml:lang="en"
      i18n:domain="collective.contact.duplicated"
>
  <body>

    <div metal:fill-slot="main">
      <form class=""
            id="form"
            method="post"
            tal:define="
              update view/update;
              colnum python:len(view.contents);
            "
            tal:attributes="
              action string:${context/absolute_url}/merge-contacts-apply;
            "
      >

        <input name="data"
               type="hidden"
               tal:attributes="
                 value python:request.get('data', None);
               "
        />

        <table class="listing nosort">
          <thead>
            <tr>
              <th></th>
              <th tal:repeat="content view/contents">
                <a target="_new"
                   tal:condition="python:content['uid']!='TEMP'"
                   tal:content="python:view.escape(content['obj'].get_full_title())"
                   tal:attributes="
                     href content/obj/absolute_url;
                   "
                ></a>
                <span tal:condition="python:content['uid']=='TEMP'"
                      i18n:ignore=""
                >Donn&eacute;es suppl&eacute;mentaires</span>
                <input name="uids:list"
                       type="hidden"
                       tal:attributes="
                         value content/uid;
                       "
                />
              </th>
              <th></th>
            </tr>
            <tr>
              <td i18n:translate="">Location</td>
              <td tal:repeat="item view/contents">
                <input name="path"
                       type="radio"
                       tal:define="
                         index repeat/item/index;
                       "
                       tal:condition="python:item['uid']!='TEMP'"
                       tal:attributes="
                         checked python:index == 0 and '1' or None;
                         id string:path-${item/uid};
                         value item/uid;
                         class index;
                       "
                />
                <label tal:condition="python:item['uid']!='TEMP'"
                       tal:content="item/path"
                       tal:attributes="
                         for string:path-${item/uid};
                       "
                ></label>
              </td>
              <td></td>
            </tr>
          </thead>

          <tal:fieldsets tal:repeat="fieldset view/fieldsets">
            <tr>
              <th tal:content="fieldset/title"
                  tal:attributes="
                    colspan python:colnum + 1;
                  "
                  i18n:translate=""
              ></th>
              <th></th>
            </tr>
            <tal:fields repeat="field fieldset/fields">
              <tr tal:define="
                    diff python:view.diff(field);
                  "
                  tal:condition="diff"
              >
                <td tal:content="python:field.title">
                </td>
                <td tal:condition="diff"
                    tal:repeat="item diff"
                >
                  <input type="radio"
                         tal:condition="item/selectable"
                         tal:attributes="
                           name field/__name__;
                           value item/uid;
                           id string:${field/__name__}-${item/uid};
                           checked item/selected;
                         "
                  />
                  <label tal:content="structure item/render"
                         tal:attributes="
                           for string:${field/__name__}-${item/uid};
                           class python: (item['differing']) and 'differing' or 'similar';
                         "
                  ></label>
                </td>
                <td class="cell-delete">
                  <tal:empty condition="not:field/required">
                    <label tal:attributes="
                             name field/__name__;
                             for string:${field/__name__}-empty;
                           ">
                      <tal:icon tal:replace="structure python:icons.tag('trash3')" />
                    </label>
                    <input value="empty"
                           tal:attributes="
                             type python:len([i for i in diff if i['selectable']]) == 0 and 'checkbox' or 'radio';
                             name field/__name__;
                             id string:${field/__name__}-empty;
                           "
                    />
                  </tal:empty>
                </td>
              </tr>
            </tal:fields>
          </tal:fieldsets>
        </table>

        <div id="hp-person-merge"
             tal:condition="view/merge_hp_persons"
        >
          <h3 i18n:translate="">Merge persons</h3>
          <input checked="1"
                 name="merge-hp-persons"
                 type="checkbox"
                 value="1"
          />
          <label i18n:translate="help_merge_hp_persons">
    	Those held positions are stored into different person contents.
            Also merge persons.</label>
          <div>
            <span i18n:translate="help_merge_hp_persons_directly">
          If you do not want to merge those held positions,
          you can move directly to person merging
            </span>
            <a tal:attributes="
                 href view/merge_person_url;
               "
               i18n:translate=""
            >Merge persons</a>
          </div>
        </div>

        <div tal:condition="python: max([len(c['back_references']) for c in view.contents]) > 0">
          <h3 i18n:translate="">Back references</h3>
          <p class="discreet"
             i18n:translate="help_back_references"
          >
   For your information : all contents that refer to merged elements will be updated
   with the one which has been selected as 'location'.
          </p>
          <div tal:repeat="content python:[c for c in view.contents if c['uid']!='TEMP']">
            <label tal:content="content/obj/Title"></label>
            <ul>
              <li tal:repeat="backref content/back_references">
                <a target="new"
                   tal:content="backref/obj/Title"
                   tal:attributes="
                     href backref/obj/absolute_url;
                   "
                ></a>
                (<span tal:content="string: ${backref/obj/portal_type} - ${backref/attribute}"></span>)
              </li>
            </ul>
          </div>
        </div>

        <div tal:define="
               have_subcontents python: max([len(c['subcontents']) for c in view.contents]) > 0;
               maybe_duplicated python:len([len(c['subcontents']) for c in view.contents if len(c['subcontents']) > 0 ]) > 1;
             "
             tal:condition="have_subcontents"
        >
          <h3 i18n:translate="">Contents</h3>
          <p class="discreet"
             tal:condition="maybe_duplicated"
             i18n:translate="help_subcontents"
          >
   All contents of the merged elements will be moved into the element selected as 'location'.
   If some of those contents have to be merged, check them and you will be redirected to a merge screen.
          </p>
          <tal:content tal:repeat="content view/contents">
            <div tal:condition="content/subcontents">
              <label tal:content="content/obj/Title"></label>
              <ul>
                <li tal:repeat="subcontent content/subcontents">
                  <input name="subcontent_uids:list"
                         type="checkbox"
                         tal:condition="maybe_duplicated"
                         tal:attributes="
                           value subcontent/UID;
                         "
                  />
                  <a target="new"
                     tal:content="subcontent/Title"
                     tal:attributes="
                       href subcontent/absolute_url;
                     "
                  ></a>
                </li>
              </ul>
            </div>
          </tal:content>
        </div>

        <input type="submit"
               value="Merge contents"
               i18n:attributes="value"
        />
      </form>
    </div>

  </body>
</html>
